{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/indexnow",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/social",
      "schedule": "0 9 * * *"
    }
  ]
}
