{
  "name": "remote-jobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.mjs && node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "boards:scan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/find-job-boards.mts",
    "feeds:scan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/find-company-feeds.mts",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-icons.mts",
    "history:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/record-history.mts",
    "social:images": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/social-images.mts",
    "snapshot:refresh": "node --env-file-if-exists=.env.local node_modules/jiti/lib/jiti-cli.mjs scripts/refresh-snapshot.mts",
    "db:migrate": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@rapideditor/country-coder": "5.6.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.9.0",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.18",
    "lucide-react": "^1.74.0",
    "mcp-handler": "^2.4.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
