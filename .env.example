# Remote Jobs: environment variables
#
# None of these are required: the site runs without any of them, and each one
# switches on an optional integration.
#
# Local development: copy this file to .env.local and fill in what you need.
# Vercel: Project → Settings → Environment Variables (Production), then
# redeploy. Every value below is read at build time, so a change only shows
# up after the next deployment.

# ── Search engines ──────────────────────────────────────────────────────────

# Google Search Console → Add property → URL prefix → "HTML tag".
# Paste only the content="…" value, e.g. abc123XYZ_example-token
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Add a site → "HTML Meta Tag" (msvalidate.01).
# Optional: Bing can also import the site straight from Search Console.
BING_SITE_VERIFICATION=

# ── Google Tag Manager / Google Analytics 4 ─────────────────────────────────
#
# Set ONE of the two:
#   - Tag Manager (recommended if you'll add more tags later): set
#     NEXT_PUBLIC_GTM_ID and add a "Google tag" with your GA4 measurement ID
#     inside the Tag Manager container.
#   - GA4 on its own: set NEXT_PUBLIC_GA_MEASUREMENT_ID.
# Setting both while GA4 is also configured in Tag Manager counts every
# visit twice.
#
# Both run under Google Consent Mode v2: visitors in the EEA, UK and
# Switzerland are asked before analytics cookies are set, everyone can change
# their answer under "Cookie choices", and ad storage is always off.

# Tag Manager → Admin → Container ID, e.g. GTM-ABC1234
NEXT_PUBLIC_GTM_ID=

# Analytics → Admin → Data streams → Web → Measurement ID, e.g. G-ABC123DEF4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Set by Vercel automatically: don't add these yourself ───────────────────
#
# VERCEL_PROJECT_PRODUCTION_URL: the production domain, used for canonical
# links, the sitemap, feeds and structured data. Locally the site falls back
# to http://localhost:3000.
#
# Vercel Web Analytics and Speed Insights need no variables: turn them on in
# the Vercel dashboard (Project → Analytics / Speed Insights).
